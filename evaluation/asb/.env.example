# Copy to .env and fill in values locally. Never commit credentials.
CBC_MODELS_DIR=/absolute/path/to/models
# Required for the original refusal metric when a sample contains multiple thinking messages.
GLM_API_KEY=
GLM_BASE_URL=
ASB_JUDGE_MODEL=deepseek-ai/DeepSeek-V3.2
# Only needed for OpenAI models, embeddings, or PromptArmor baseline.
OPENAI_API_KEY=
OPENAI_BASE_URL=
ARK_API_KEY=
ARK_BASE_URL=
# PromptArmor injection-filter model served by ARK_BASE_URL.
PROMPTARMOR_MODEL=kimi-k2.6
# Optional vLLM allocation settings (defaults preserve each backend's settings).
ASB_TENSOR_PARALLEL_SIZE=2
ASB_MAX_MODEL_LEN=16192
# ASB_GPU_MEMORY_UTILIZATION=0.5
